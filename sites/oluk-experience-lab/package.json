{
  "name": "oluk-experience-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "proof:tokens": "node scripts/proof/token-contract.mjs --check=tests/contracts/governed-token-manifest.json",
    "proof:sites-handoff-baseline": "node scripts/proof/sites-handoff-baseline.mjs",
    "proof:provenance": "node scripts/proof/component-provenance.mjs",
    "proof:taxonomy": "node scripts/proof/taxonomy-contract-smoke.mjs",
    "proof:code-bridge": "node scripts/proof/figma-code-bridge.mjs",
    "proof:css-colors": "node scripts/proof/css-color-contract.mjs",
    "inventory:generate": "node scripts/proof/figma-code-bridge.mjs --write",
    "contract:generate": "node scripts/generate-governed-contract.mjs",
    "contract:check": "node scripts/generate-governed-contract.mjs --check",
    "review:generate": "node scripts/generate-review-studio-payload.mjs",
    "review:check": "node scripts/generate-review-studio-payload.mjs --check",
    "design-sync:reconcile": "node scripts/reconcile-design-sync.mjs",
    "design-sync:check": "node scripts/reconcile-design-sync.mjs --check",
    "openlab:compile": "node scripts/compile-openlab-product-experience.mjs",
    "openlab:check": "node scripts/compile-openlab-product-experience.mjs --check",
    "product:compile": "node scripts/compile-product-experience.mjs",
    "product:check": "node scripts/compile-product-experience.mjs --check",
    "promotion:generate": "node scripts/generate-route-promotion-matrix.mjs",
    "promotion:check": "node scripts/generate-route-promotion-matrix.mjs --check",
    "template-catalogue:generate": "node scripts/generate-site-template-composition-catalogue.mjs",
    "template-catalogue:check": "node scripts/generate-site-template-composition-catalogue.mjs --check",
    "feature-intent:generate": "node scripts/generate-feature-intent-registry.mjs",
    "feature-intent:check": "node scripts/generate-feature-intent-registry.mjs --check",
    "grammar:generate": "npm run build && node scripts/proof/customer-surface-grammar.mjs --write",
    "grammar:check": "node scripts/proof/customer-surface-grammar.mjs --check",
    "proof:visual-baselines": "node scripts/proof/visual-baseline.mjs",
    "proof:contracts": "npm run contract:check && npm run design-sync:check && npm run product:check && npm run openlab:check && npm run template-catalogue:check && npm run promotion:check && npm run feature-intent:check && npm run review:check && npm run grammar:check && npm run proof:tokens && npm run proof:css-colors && npm run proof:provenance && npm run proof:taxonomy && npm run proof:code-bridge && npm run proof:visual-baselines",
    "proof:cx39": "node scripts/proof/asset-font-performance.mjs",
    "proof:cx45": "node scripts/proof/customer-copy-audit.mjs",
    "proof:final-static": "npm run build && npm run proof:cx39 && npm run proof:cx45",
    "proof:mf09": "node scripts/proof/mf09-four-width.mjs",
    "proof:mf09:qa": "node scripts/proof/mf09-four-width.mjs --mode=qa",
    "proof:champion": "node scripts/proof/champion-capture.mjs",
    "proof:a11y": "node scripts/proof/accessibility-smoke.mjs",
    "proof:contrast-zoom": "node scripts/proof/contrast-zoom-stress.mjs",
    "proof:interactions": "node scripts/proof/interaction-state-proof.mjs",
    "proof:mobile-compaction": "node scripts/proof/mobile-compaction-contract.mjs",
    "proof:local": "node scripts/proof/run-local.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "axe-core": "^4.11.4",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
