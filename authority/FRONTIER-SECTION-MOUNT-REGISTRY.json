{
  "schemaVersion": "oluk.frontier-section-mount.v1",
  "program": "OLUK Frontier Build Program",
  "activeMode": "light",
  "routeLaws": { "product": "/product/:slug", "openLab": "/open-lab" },
  "mobileContract": { "touchTarget": "44px", "reviewWidths": [1440, 390], "automationWidths": [1024, 768], "unauthorisedHorizontalScroll": false },
  "sections": [
    {"id":"frontier-product-hero","mounts":["/product/:slug"],"mobileStrategy":"summary","states":["default","unavailable"],"dataContext":"ProductContentRecord"},
    {"id":"product-narrative","mounts":["/product/:slug"],"mobileStrategy":"collapse","states":["detail","evidence","reviews"],"dataContext":"ProductContentRecord"},
    {"id":"product-continuation","mounts":["/product/:slug","/bag","/checkout/confirmation","/account/dashboard"],"mobileStrategy":"carousel","states":["related","unavailable"],"dataContext":"StackPresentation"},
    {"id":"stack-explorer","mounts":["/bundle-builder","/product/:slug","/bag"],"mobileStrategy":"collapse","states":["bulking","cutting","recomp","pct"],"dataContext":"StackPresentation"},
    {"id":"catalogue-grid","mounts":["/shop","/shop/:family","/collections/:slug","/search"],"mobileStrategy":"reorder","states":["filtered","empty"],"dataContext":"ProductContentRecord[]"},
    {"id":"product-comparison","mounts":["/compare"],"mobileStrategy":"horizontal-scroll","states":["default","unavailable"],"dataContext":"ProductContentRecord[]"},
    {"id":"openlab-record-suite","mounts":["/open-lab","/open-lab/records","/open-lab/compound/:slug","/open-lab/report/:batchId"],"mobileStrategy":"horizontal-scroll","states":["verified-evidence","source-reported","source-only","unavailable"],"dataContext":"OpenLabPresentationRecord"},
    {"id":"openlab-tools","mounts":["/open-lab/batch-lookup","/open-lab/methodology","/open-lab/source-chain","/open-lab/compare"],"mobileStrategy":"collapse","states":["default","no-results","unavailable"],"dataContext":"OpenLabPresentationRecord"},
    {"id":"openlab-frontier-guide","mounts":["/open-lab/evidence","/open-lab/compound-guide","/open-lab/research-papers","/open-lab/lab-partner"],"mobileStrategy":"reorder","states":["overview","filtered","detail"],"dataContext":"OpenLabFrontierContent"},
    {"id":"openlab-frontier-planning","mounts":["/open-lab/stack-builder","/open-lab/dosing-calculator","/open-lab/cycle-planner","/open-lab/interaction-checker"],"mobileStrategy":"collapse","states":["input","selection","summary"],"dataContext":"OpenLabPlanningPresentation"},
    {"id":"openlab-sidebar-workspace","mounts":["/open-lab/dosing-calculator","/open-lab/cycle-planner","/open-lab/case-studies","/open-lab/glossary"],"mobileStrategy":"collapse","states":["index","focused"],"dataContext":"OpenLabFrontierContent"},
    {"id":"openlab-document-viewer","mounts":["/open-lab/coa/:id"],"mobileStrategy":"summary","states":["document","table"],"dataContext":"OpenLabFrontierContent"},
    {"id":"checkout-lifecycle","mounts":["/bag","/checkout/:stage"],"mobileStrategy":"summary","states":["bag","information","delivery","review","payment","processing","confirmation","tracking","receipt","return","refund"],"dataContext":"CheckoutPresentation"},
    {"id":"post-purchase-surface","mounts":["/order/success/:orderId?","/order/pending/:orderId?","/order/failed/:orderId?","/order/cancelled/:orderId?","/order/tracking/:orderId"],"mobileStrategy":"reorder","states":["success","pending","failed","cancelled","tracking"],"dataContext":"OrderPresentation"},
    {"id":"account-hub","mounts":["/account/:surface"],"mobileStrategy":"reorder","states":["empty","active","paused","due-soon"],"dataContext":"AccountPresentation"},
    {"id":"faq-help","mounts":["/faq-help-centre","/about","/product/:slug"],"mobileStrategy":"collapse","states":["default"],"dataContext":"FaqPresentation"},
    {"id":"support-surface","mounts":["/shipping-returns","/faq","/international","/gift-cards","/legal/:doc","/cookies","/refunds","/sitemap"],"mobileStrategy":"collapse","states":["default"],"dataContext":"SupportPresentation"}
  ],
