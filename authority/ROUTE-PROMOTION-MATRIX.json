      "promotable": ["OpenLab record preview", "compound comparison", "report viewer preview", "RestockCard", "reviews", "collection continuation"],
      "standaloneDestinations": ["/open-lab/compound/:slug", "/open-lab/report/:batchId", "/open-lab/compare", "/open-lab/stack-builder"]
    },
    {
      "id": "openlab",
      "paths": ["/open-lab", "/open-lab/records", "/open-lab/compound/:slug", "/open-lab/report/:batchId", "/open-lab/:tool"],
      "promoted": ["HeroLight entry", "record archive", "compound dossier", "report/document viewer", "technical evidence visualizations", "stack and comparison tools"],
      "promotable": ["ProductCommerceCard return rail", "PDP evidence snapshot", "related product rail", "stack outcome cards", "methodology and source-chain storytelling"],
