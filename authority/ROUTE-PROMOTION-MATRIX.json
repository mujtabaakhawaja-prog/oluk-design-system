      "promotable": ["YourStackBuilder compact rail", "ProductEvidenceSnapshot", "related products", "quick reorder", "loyalty and saved stack"],
      "standaloneDestinations": ["/open-lab/stack-builder", "/product/:slug", "/account/loyalty"]
    },
    {
      "id": "discovery-support",
      "paths": ["/shop", "/shop/:family", "/collections/:slug", "/search", "/compare", "/faq-help-centre", "/about"],
      "promoted": ["CommerceDiscoveryFilters", "ProductCommerceCard grids", "comparison cards", "FAQ disclosure", "brand and trust storytelling"],
      "promotable": ["StackOutcomeCard", "OpenLab record preview", "collection campaign rail", "ProductDossier preview"],
      "standaloneDestinations": ["/open-lab", "/open-lab/compare", "/bundle-builder"]
    }
