{
  "schemaVersion": "oluk.route-promotion.v1",
  "status": "ACTIVE_DESIGN_PROGRAM",
  "authority": "Codex Sites is the source of truth. This map defines customer-facing placements, not runtime ownership or Figma authority.",
  "templates": [
    {
      "id": "homepage",
      "paths": ["/"],
