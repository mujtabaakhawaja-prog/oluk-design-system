{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olympuslabs.uk/schemas/customer-content-ledger.v1.schema.json",
  "title": "OLUK Customer Content Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "status", "authorityPin", "routeApplicability", "slotLaw", "products"],
  "properties": {
    "$schema": {"const": "./schemas/customer-content-ledger.schema.json"},
    "schemaVersion": {"const": "oluk.customer-content-ledger.v1"},
    "status": {"const": "PROVIDER_NEUTRAL_REFERENCE"},
    "authorityPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeContractId", "runtimeContractVersion", "identity", "valueLaw", "contentStructureSourceCommit"],
      "properties": {
        "runtimeContractId": {"const": "OLUK_RUNTIME_CONSUMPTION_REGISTRY_V1"},
        "runtimeContractVersion": {"const": "1.3.0"},
        "identity": {"const": "OPTION_B_PREMIUM_LOCKED"},
        "valueLaw": {"const": "NO_CUSTOMER_VALUE_WITHOUT_OWNER_APPROVAL"},
        "contentStructureSourceCommit": {"const": "5cdb7fbe9e76cde2a37b890d3c3811a47364ff7a"}
      }
    },
    "routeApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registryPath", "registryCommit", "routeCount", "sha256", "surfaceFamilies"],
      "properties": {
        "registryPath": {"const": "olympus:apps/olympus-shopper-ui/app/route-authority/oluk-canonical-customer-route-registry.v1.json"},
        "registryCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "routeCount": {"const": 74},
        "sha256": {"$ref": "#/$defs/sha256"},
        "surfaceFamilies": {
          "type": "object",
          "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "slotLaw": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slotId", "necessity", "valueOwner", "runtimeFieldRefs", "missingBehavior", "customerLanguageLaw"],
        "properties": {
          "slotId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "necessity": {"enum": ["required", "optional"]},
          "valueOwner": {"enum": ["OLUK_SEMANTIC_REGISTRY", "OLUK_APPROVED_EDITORIAL", "OLUK_RELATIONSHIP_AUTHORITY", "OPENLAB_C2"]},
          "runtimeFieldRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "missingBehavior": {"enum": ["suppress-product-module", "omit-slot", "render-locked-unavailable-state"]},
          "customerLanguageLaw": {"type": "string", "minLength": 1}
        }
      }
    },
    "products": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonicalProductId", "applicableSurfaceFamilies", "slotStates", "operatorProvenance"],
        "properties": {
          "canonicalProductId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "applicableSurfaceFamilies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "slotStates": {
            "type": "object",
            "additionalProperties": {"enum": ["runtime-bound", "approved", "candidate-only", "unresolved"]}
          },
          "operatorProvenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["identitySource", "contentStructureSource", "customerVisible"],
            "properties": {
              "identitySource": {"type": "string", "minLength": 1},
              "contentStructureSource": {"type": "string", "minLength": 1},
              "customerVisible": {"const": false}
            }
          }
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
