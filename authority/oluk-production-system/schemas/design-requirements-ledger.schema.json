{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olympuslabs.uk/schemas/design-requirements-ledger.v1.schema.json",
  "title": "OLUK Design Requirements Ledger",
  "description": "Validates reference-only presentation requirements against provider-neutral runtime field IDs without restating runtime wire schemas or values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "status",
    "authorityPin",
    "sourcePins",
    "requirements"
  ],
  "properties": {
    "$schema": {
      "const": "./schemas/design-requirements-ledger.schema.json"
    },
    "schemaVersion": {
      "const": "oluk.design-requirements-ledger.v1"
    },
    "status": {
      "const": "REFERENCE_ONLY_PINNED"
    },
    "authorityPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "runtimeContractId",
        "runtimeContractVersion"
      ],
      "properties": {
        "document": {
          "const": "DESIGN-AUTHORITY-PIN.md"
        },
        "runtimeContractId": {
          "const": "OLUK_RUNTIME_CONSUMPTION_REGISTRY_V1"
        },
        "runtimeContractVersion": {
          "const": "1.3.0"
        }
      }
    },
    "sourcePins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "programmeAmendmentSha256",
        "runtimeContractSha256",
        "legacyDispositionRegistrySha256",
        "continuationQueueSha256",
        "canonicalRouteRegistrySha256"
      ],
      "properties": {
        "programmeAmendmentSha256": {
          "$ref": "#/$defs/sourcePin"
        },
        "runtimeContractSha256": {
          "$ref": "#/$defs/sourcePin"
        },
        "legacyDispositionRegistrySha256": {
          "$ref": "#/$defs/sourcePin"
        },
        "continuationQueueSha256": {
          "$ref": "#/$defs/sourcePin"
        },
        "canonicalRouteRegistrySha256": {
          "$ref": "#/$defs/sourcePin"
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/designRequirement"
      }
    }
  },
  "$defs": {
    "sourcePin": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "designRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementId",
        "kind",
        "name",
        "componentOwner",
        "surfaceContexts",
        "contractRef",
        "fieldRefs",
        "variants",
        "stateObligations",
        "responsiveObligations",
        "accessibilityObligations",
        "forbiddenBehaviors"
      ],
      "properties": {
        "requirementId": {
          "type": "string",
          "pattern": "^DSR-[0-9]{3}$"
        },
        "kind": {
          "enum": [
            "component",
            "surface"
          ]
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "componentOwner": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "surfaceContexts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "contractRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractId",
            "version"
          ],
          "properties": {
            "contractId": {
              "const": "OLUK_RUNTIME_CONSUMPTION_REGISTRY_V1"
            },
            "version": {
              "const": "1.3.0"
            }
          }
        },
        "fieldRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fieldRef"
          }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/obligation"
          }
        },
        "stateObligations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/obligation"
          }
        },
        "responsiveObligations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/obligation"
          }
        },
        "accessibilityObligations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/obligation"
          }
        },
        "forbiddenBehaviors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "fieldRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldId",
        "necessity",
        "missingBehavior"
      ],
      "properties": {
        "fieldId": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*|\\[\\]\\.[A-Za-z][A-Za-z0-9]*)+$"
        },
        "necessity": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "missingBehavior": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "requirement"
          ],
          "properties": {
            "mode": {
              "enum": [
                "suppress-component",
                "suppress-item",
                "omit-element",
                "render-unavailable",
                "disable-interaction",
                "preserve-layout-without-value"
              ]
            },
            "requirement": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "requirement": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
