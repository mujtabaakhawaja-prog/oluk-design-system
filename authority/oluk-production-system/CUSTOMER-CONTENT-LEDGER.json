      "slotId": "product-identity",
      "necessity": "required",
      "valueOwner": "OLUK_SEMANTIC_REGISTRY",
      "runtimeFieldRefs": ["product.canonicalProductId", "product.customerName"],
      "missingBehavior": "suppress-product-module",
