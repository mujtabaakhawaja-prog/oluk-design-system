      "customerLanguageLaw": "Never promote candidate, proof, fixture, source, compiler, or authority language to a customer surface."
    },
    {
      "slotId": "relationship-rationale",
      "necessity": "optional",
      "valueOwner": "OLUK_RELATIONSHIP_AUTHORITY",
      "runtimeFieldRefs": ["product.canonicalProductId"],
      "missingBehavior": "omit-slot",
      "customerLanguageLaw": "Suppress the recommendation when no typed product-specific relationship and approved rationale exist."
    },
    {
      "slotId": "evidence-summary",
      "necessity": "optional",
      "valueOwner": "OPENLAB_C2",
      "runtimeFieldRefs": ["openlab.evidenceRecords[].verificationState", "openlab.evidenceRecords[].analytes[].results[].displayValue"],
      "missingBehavior": "render-locked-unavailable-state",
      "customerLanguageLaw": "Render only exact product-specific REPORTED evidence; record existence or provider state is not customer evidence copy."
    },
    {
      "slotId": "seo-description",
      "necessity": "optional",
      "valueOwner": "OLUK_APPROVED_EDITORIAL",
      "runtimeFieldRefs": ["product.canonicalProductId", "product.customerName"],
      "missingBehavior": "omit-slot",
      "customerLanguageLaw": "Do not synthesize a claim, price, stock state, or evidence statement for metadata."
    }
  ],
